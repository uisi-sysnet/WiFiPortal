# Production .env for the Ubuntu server. deploy/setup-server.sh copies this to .env,
# generates APP_KEY and fills DB_PASSWORD. Edit APP_URL, PORTAL_URL and RADIUS_* yourself.

APP_NAME="Public WiFi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Address you open the dashboard at
APP_URL=http://192.168.1.10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wifiportal
DB_USERNAME=wifiportal
DB_PASSWORD=

# Keep the portal session cookie usable over plain HTTP (phones aren't logged in yet)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

QUEUE_CONNECTION=database
# Must be longer than the slowest job (video transcoding, up to 1000 s),
# otherwise a still-running job is handed to a second worker.
DB_QUEUE_RETRY_AFTER=1100

# Email for reports: set the SMTP server in Settings > Email (stored encrypted), or here
MAIL_MAILER=log

# Converts uploaded videos for the advertisement page (apt install ffmpeg)
FFMPEG_PATH=/usr/bin/ffmpeg

# Optional dark basemap key for the dashboard map
CARTO_API_KEY=

# Default access time; set it per type of user (resident, visitor, student) in Settings
HOTSPOT_CREDENTIAL_HOURS=24
HOTSPOT_USERNAME_PREFIX=wifi-

# ---- Hotspot (same keys as .env.hotspot.example) ----

# Address plan: one /20 per router out of a /10 = 1,024 routers x 4,093 devices
HOTSPOT_SUPERNET=10.64.0.0/10
HOTSPOT_SITE_PREFIX=20

HOTSPOT_DNS_NAME=login.wifi
HOTSPOT_DNS_SERVERS=1.1.1.1,8.8.8.8
HOTSPOT_LEASE_TIME=1h
HOTSPOT_IDLE_TIMEOUT=5m
HOTSPOT_KEEPALIVE_TIMEOUT=2m
HOTSPOT_SESSION_TIMEOUT=4h
HOTSPOT_RATE_LIMIT=5M/10M
HOTSPOT_MAC_COOKIE_TIMEOUT=1d
HOTSPOT_WALLED_GARDEN=

# Central RADIUS (FreeRADIUS on this server, set up by deploy/setup-radius.sh, which fills
# RADIUS_HOST, RADIUS_SECRET and RADIUS_TIMEZONE). Leave RADIUS_HOST empty to skip.
RADIUS_HOST=
RADIUS_SECRET=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
# Clock of the FreeRADIUS server, for the Expiration of each login (Asia/Manila if it runs on local time)
RADIUS_TIMEZONE=UTC
# RADIUS page: keep login attempts / finished sessions this many days
RADIUS_AUTH_LOG_DAYS=30
RADIUS_ACCT_DAYS=365

MIKROTIK_API_PORT=8728
MIKROTIK_API_SSL_PORT=8729
MIKROTIK_API_TIMEOUT=10

# Live dashboard: how often every router is asked for its online users (15, 30 or 60 s)
ROUTER_POLL_SECONDS=30
ROUTER_POLL_TIMEOUT=3

# Capacity alerts: % of a router's rated users / smoothed CPU / a network's address pool
CAPACITY_BUSY_PERCENT=80
CAPACITY_FULL_PERCENT=95
CAPACITY_CPU_BUSY_PERCENT=85
CAPACITY_CPU_FULL_PERCENT=95
# Rated users for router models not in config/mikrotik_models.php
CAPACITY_DEFAULT_USERS=200

VLAN_HOTSPOT_ID=10
VLAN_HOTSPOT_NAME=vlan10-hotspot
VLAN_MGMT_ID=99
VLAN_MGMT_NAME=vlan99-mgmt
VLAN_TEST_ID=20
VLAN_TEST_NAME=vlan20-test
VLAN_MGMT_NATIVE=false

MGMT_SUPERNET=172.20.0.0/14
TEST_SUPERNET=172.24.0.0/14
LAN_SUPERNET=172.16.0.0/14
MGMT_LEASE_TIME=1d
TEST_LEASE_TIME=1h
LAN_LEASE_TIME=1d

# Public address of this server, reachable by routers AND by phones on the hotspot
# (plain http:// — routers fetch login.html from it and walled-garden its host).
PORTAL_URL=http://192.168.1.10

# Clients per access point: ask an AP with no readable count again after (minutes); keep hourly logs (days)
AP_CLIENTS_RETRY_MINUTES=60
AP_CLIENT_STATS_DAYS=730
# Network status: CRITICAL when at least this % of access points is offline (or a router is down)
CRITICAL_AP_PERCENT=25
