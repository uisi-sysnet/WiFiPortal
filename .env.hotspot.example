# ---- append to your .env ----
DB_CONNECTION=pgsql
QUEUE_CONNECTION=database

# Address plan: one /20 per router out of a /10 = 1,024 routers x 4,093 devices
HOTSPOT_SUPERNET=10.64.0.0/10
HOTSPOT_SITE_PREFIX=20

HOTSPOT_DNS_NAME=login.wifi
HOTSPOT_DNS_SERVERS=1.1.1.1,8.8.8.8
HOTSPOT_LEASE_TIME=1h
HOTSPOT_IDLE_TIMEOUT=5m
HOTSPOT_KEEPALIVE_TIMEOUT=2m
HOTSPOT_SESSION_TIMEOUT=4h
HOTSPOT_RATE_LIMIT=5M/10M
HOTSPOT_MAC_COOKIE_TIMEOUT=1d
HOTSPOT_WALLED_GARDEN=

# Central RADIUS (FreeRADIUS). Leave RADIUS_HOST empty to skip.
RADIUS_HOST=
RADIUS_SECRET=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

MIKROTIK_API_PORT=8728
MIKROTIK_API_SSL_PORT=8729
MIKROTIK_API_TIMEOUT=10
