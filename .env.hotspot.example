# ---- append to your .env ----
DB_CONNECTION=pgsql
QUEUE_CONNECTION=database
# Longer than the slowest job (video transcoding, up to 1000 s), or it runs twice
DB_QUEUE_RETRY_AFTER=1100

# Address plan: one /20 per router out of a /10 = 1,024 routers x 4,093 devices
HOTSPOT_SUPERNET=10.64.0.0/10
HOTSPOT_SITE_PREFIX=20

HOTSPOT_DNS_NAME=login.wifi
HOTSPOT_DNS_SERVERS=1.1.1.1,8.8.8.8
HOTSPOT_LEASE_TIME=1h
HOTSPOT_IDLE_TIMEOUT=5m
HOTSPOT_KEEPALIVE_TIMEOUT=2m
HOTSPOT_SESSION_TIMEOUT=4h
HOTSPOT_RATE_LIMIT=5M/10M
HOTSPOT_MAC_COOKIE_TIMEOUT=1d
HOTSPOT_WALLED_GARDEN=

# Central RADIUS (FreeRADIUS). Leave RADIUS_HOST empty to skip.
RADIUS_HOST=
RADIUS_SECRET=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

MIKROTIK_API_PORT=8728
MIKROTIK_API_SSL_PORT=8729
MIKROTIK_API_TIMEOUT=10

# VLANs on the trunk bridge (defaults for the Add router form)
VLAN_HOTSPOT_ID=10
VLAN_HOTSPOT_NAME=vlan10-hotspot
VLAN_MGMT_ID=99
VLAN_MGMT_NAME=vlan99-mgmt
VLAN_TEST_ID=20
VLAN_TEST_NAME=vlan20-test
VLAN_MGMT_NATIVE=false

# One /24 per router from each plan (each /14 = 1,024 routers)
MGMT_SUPERNET=172.20.0.0/14
TEST_SUPERNET=172.24.0.0/14
LAN_SUPERNET=172.16.0.0/14
MGMT_LEASE_TIME=1d
TEST_LEASE_TIME=1h
LAN_LEASE_TIME=1d

# Public address of this app, reachable by routers AND by phones on the hotspot.
# The router downloads login.html from here, and the host is walled-gardened.
PORTAL_URL=http://192.168.1.10:8000
